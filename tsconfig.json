{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": { "@game/*": ["./src/games/firered/*"], "@core/*": ["./src/core/*"] }
  },
  "include": ["src/main.ts", "src/hns/maps.ts", "src/viewer/main.ts", "src/compare/main.ts", "src/compare/dexMain.ts", "src/compare/libraryMain.ts", "src/compare/questsMain.ts", "src/compare/storyMain.ts"]
}
