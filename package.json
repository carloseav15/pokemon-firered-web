{
  "name": "pokemon-gba-web-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check:port": "tsc --noEmit --project tsconfig.port.json",
    "check:honesty": "python3 tools/checks/honesty.py",
    "check:all": "python3 tools/checks/all.py",
    "check:m4a": "esbuild tools/checks/m4aAudio.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.decomp-build/checks/m4aAudio.mjs && node .decomp-build/checks/m4aAudio.mjs",
    "playwright:install": "playwright install chromium --only-shell",
    "check:arrow": "esbuild tools/checks/downArrow.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.decomp-build/checks/downArrow.mjs && node .decomp-build/checks/downArrow.mjs",
