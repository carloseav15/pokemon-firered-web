{
  "name": "pokemon-gba-web-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check:port": "tsc --noEmit --project tsconfig.port.json",
    "check:honesty": "python3 tools/checks/honesty.py",
    "check:arrow": "esbuild tools/checks/downArrow.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.decomp-build/checks/downArrow.mjs && node .decomp-build/checks/downArrow.mjs",
    "check:renewable": "esbuild tools/checks/renewableHiddenItems.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.decomp-build/checks/renewableHiddenItems.mjs && node .decomp-build/checks/renewableHiddenItems.mjs",
    "check:preview": "esbuild tools/checks/mapPreviewScreen.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.decomp-build/checks/mapPreviewScreen.mjs && node .decomp-build/checks/mapPreviewScreen.mjs",
    "check:summary": "esbuild tools/checks/pokemonSummaryScreen.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.decomp-build/checks/pokemonSummaryScreen.mjs && node .decomp-build/checks/pokemonSummaryScreen.mjs",
    "check:evolution": "esbuild tools/checks/evolutionScene.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.decomp-build/checks/evolutionScene.mjs && node .decomp-build/checks/evolutionScene.mjs",
    "check:card": "esbuild tools/checks/trainerCard.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.decomp-build/checks/trainerCard.mjs && node .decomp-build/checks/trainerCard.mjs",
    "inventory": "python3 tools/portInventory.py",
    "pending": "python3 tools/portPending.py",
    "check:braille": "esbuild tools/checks/braille.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.decomp-build/checks/braille.mjs && node .decomp-build/checks/braille.mjs",
    "check:anims": "esbuild tools/checks/battleAnims.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.decomp-build/checks/battleAnims.mjs && node .decomp-build/checks/battleAnims.mjs",
    "check:transitions": "esbuild tools/checks/fieldAndBattleTransitions.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.decomp-build/checks/fieldAndBattleTransitions.mjs && node .decomp-build/checks/fieldAndBattleTransitions.mjs",
    "check:earlybattles": "esbuild tools/checks/earlyBattlesActionSelection.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.decomp-build/checks/earlyBattlesActionSelection.mjs && node .decomp-build/checks/earlyBattlesActionSelection.mjs",
    "check:imgfx": "esbuild tools/checks/imageProcessingEffects.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.decomp-build/checks/imageProcessingEffects.mjs && node .decomp-build/checks/imageProcessingEffects.mjs",
    "check:learnmove": "esbuild tools/checks/learnMove.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.decomp-build/checks/learnMove.mjs && node .decomp-build/checks/learnMove.mjs",
    "check:storage": "esbuild tools/checks/storageMenu.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.decomp-build/checks/storageMenu.mjs && node .decomp-build/checks/storageMenu.mjs",
    "check:weather": "esbuild tools/checks/weather.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.decomp-build/checks/weather.mjs && node .decomp-build/checks/weather.mjs",
    "check:teachytv": "esbuild tools/checks/teachyTv.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.decomp-build/checks/teachyTv.mjs && node .decomp-build/checks/teachyTv.mjs",
    "check:brock-action": "esbuild tools/checks/brockActionSelection.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.decomp-build/checks/brockActionSelection.mjs && node .decomp-build/checks/brockActionSelection.mjs",
    "check:famechecker": "esbuild tools/checks/fameChecker.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.decomp-build/checks/fameChecker.mjs && node .decomp-build/checks/fameChecker.mjs",
    "check:slots": "esbuild tools/checks/slotMachine.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.decomp-build/checks/slotMachine.mjs && node .decomp-build/checks/slotMachine.mjs",
    "check:trade": "esbuild tools/checks/tradeScene.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.decomp-build/checks/tradeScene.mjs && node .decomp-build/checks/tradeScene.mjs",
    "check:coins": "esbuild tools/checks/coins.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.decomp-build/checks/coins.mjs && node .decomp-build/checks/coins.mjs",
    "generate:string-util": "python3 tools/decomp/clang_codegen.py",
    "check:string-util": "esbuild tools/checks/stringUtil.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.decomp-build/checks/stringUtil.mjs && node .decomp-build/checks/stringUtil.mjs",
    "check:wild-encounter": "esbuild tools/checks/wildEncounter.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.decomp-build/checks/wildEncounter.mjs && node .decomp-build/checks/wildEncounter.mjs",
    "check:script": "esbuild tools/checks/scriptContext.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.decomp-build/checks/scriptContext.mjs && node .decomp-build/checks/scriptContext.mjs",
    "check:trainer-see": "esbuild tools/checks/trainerSee.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.decomp-build/checks/trainerSee.mjs && node .decomp-build/checks/trainerSee.mjs",
    "check:battle-util": "esbuild tools/checks/battleUtil.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.decomp-build/checks/battleUtil.mjs && node .decomp-build/checks/battleUtil.mjs",
    "check:questlog-battle": "esbuild tools/checks/questLogBattle.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.decomp-build/checks/questLogBattle.mjs && node .decomp-build/checks/questLogBattle.mjs",
    "check:cereader-tool": "esbuild tools/checks/cereaderTool.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.decomp-build/checks/cereaderTool.mjs && node .decomp-build/checks/cereaderTool.mjs",
    "check:wonder-news": "esbuild tools/checks/wonderNews.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.decomp-build/checks/wonderNews.mjs && node .decomp-build/checks/wonderNews.mjs",
    "check:questlog-objects": "esbuild tools/checks/questLogObjects.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.decomp-build/checks/questLogObjects.mjs && node .decomp-build/checks/questLogObjects.mjs"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
